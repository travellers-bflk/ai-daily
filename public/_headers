/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # CSP 说明（改动前务必读完）：
  #  - 只放行 Cloudflare 自己的两个域，为的是让 Web Analytics / Browser Insights
  #    真正能跑：信标脚本被拦时不会报错，只会静默地一条数据都收不到（1.3.1）。
  #  - Bot Fight Mode 注入的是**内联**脚本，且每次请求内容都不同（内含随机 r/t），
  #    无法用 hash 放行，官方也明确不推荐 'unsafe-inline'。改为由
  #    functions/_middleware.js 在响应头里注入一次性 nonce——Cloudflare 会解析
  #    响应头的 nonce 并盖到它注入的脚本上。该文件失效时退回这里的严格策略。
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 覆盖托管方默认的 Access-Control-Allow-Origin: *：本站无跨源读取需求
  Access-Control-Allow-Origin: https://439952066.xyz
  # 本站无弹窗/跨源嵌入需求，收敛到同源（1.4.0 加固）
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# /_astro/* 文件名自带内容哈希，内容一变就换名，可安全长缓存。
# 未配此规则时继承 Pages 默认的 4 小时 + must-revalidate，回访每次都要条件请求
# （第四轮审查 P2-6）。后写的规则覆盖先写的，故本段放在 /* 之后。
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 没有内容哈希的静态资源给 1 天缓存：内容真要更换时接受最长一天的延迟（1.4.0）。
# rss.xml 不在此列——阅读器按自己的节奏轮询，保持默认的短缓存。
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
