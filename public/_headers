/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 覆盖托管方默认的 Access-Control-Allow-Origin: *：本站无跨源读取需求
  Access-Control-Allow-Origin: https://439952066.xyz

# /_astro/* 文件名自带内容哈希，内容一变就换名，可安全长缓存。
# 未配此规则时继承 Pages 默认的 4 小时 + must-revalidate，回访每次都要条件请求
# （第四轮审查 P2-6）。后写的规则覆盖先写的，故本段放在 /* 之后。
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
