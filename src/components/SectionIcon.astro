---
import { ICONS } from '../lib/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
// hasOwn 而非直接下标：name 撞上 Object 原型成员时会取到函数并被 set:html 注入
const path = Object.hasOwn(ICONS, name) ? ICONS[name] : ICONS.default;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`icon ${className}`}
  aria-hidden="true"
  set:html={path}
/>