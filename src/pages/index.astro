---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { extractHeadlines, WEEKDAYS } from '../lib/utils';

const reports = (await getCollection('daily')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 按月分组
const groups: {
  year: number;
  month: number;
  items: typeof reports;
}[] = [];

for (const report of reports) {
  const d = report.data.date;
  const last = groups[groups.length - 1];
  if (
    last &&
    last.year === d.getFullYear() &&
    last.month === d.getMonth() + 1
  ) {
    last.items.push(report);
  } else {
    groups.push({ year: d.getFullYear(), month: d.getMonth() + 1, items: [report] });
  }
}

const totalCount = reports.length;
const allHeadlines = reports.flatMap((r) => extractHeadlines(r.body));
---

<Base title="AI 日报 · 每日 AI 行业资讯">
  <section class="hero">
    <h1>AI 日报</h1>
    <p>每日 AI 行业资讯，由 AI 搜集整理。信息密度优先，克制客观。</p>
    <div class="hero-stats">
      <span><b>{totalCount}</b> 期日报</span>
      <span><b>{allHeadlines.length}</b> 条速览</span>
    </div>
  </section>

  {groups.length === 0 && <p class="empty-tip">暂无日报，敬请期待。</p>}

  {
    groups.map((group) => {
      const monthLabel = `${group.year} 年 ${group.month} 月`;
      const archiveHref = `/archive/${group.year}/${String(group.month).padStart(2, '0')}/`;
      return (
        <section class="month-group">
          <h2 class="month-heading">
            <span>{monthLabel}</span>
            <a href={archiveHref} class="archive-link">查看全部</a>
          </h2>
          <div class="day-grid">
            {group.items.map((report) => {
              const d = report.data.date;
              const headlines = extractHeadlines(report.body);
              return (
                <a class="day-card" href={`/daily/${report.id}/`}>
                  <div class="day-card-date">
                    <span class="num">
                      {d.getMonth() + 1}/{d.getDate()}
                    </span>
                    <span class="weekday">周{WEEKDAYS[d.getDay()]}</span>
                  </div>
                  {headlines.length > 0 ? (
                    <ul class="day-card-headlines">
                      {headlines.slice(0, 3).map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="day-card-empty">暂无速览</p>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .archive-link {
    font-size: 0.76rem;
    color: var(--fg-faint);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    margin-left: auto;
  }
  .archive-link:hover {
    color: var(--accent);
  }
</style>