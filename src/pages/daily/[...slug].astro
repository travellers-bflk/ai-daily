---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import { formatDate, WEEKDAYS, isoDate } from '../../lib/utils';
import { parseDaily, renderSourcesHtml, renderInlineMarkdown } from '../../lib/parser';
import { distinctMediaCount } from '../../lib/sources';
import { getSectionMeta } from '../../lib/sections';

export async function getStaticPaths() {
  const reports = await getCollection('daily');
  const sorted = reports.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return sorted.map((report, i) => ({
    params: { slug: report.id },
    props: {
      report,
      newer: sorted[i - 1] ?? null,
      older: sorted[i + 1] ?? null,
    },
  }));
}

const { report, newer, older } = Astro.props;
const parsed = parseDaily(report.body ?? '');
const totalNews = parsed.sections.reduce((n, s) => n + s.items.length, 0);
// 去重媒体数：唯一实现在 sources.ts（链接文字剥离转载注记后去重）
const totalSources = distinctMediaCount(
  parsed.sections.flatMap((s) => s.items.flatMap((i) => i.sources))
);
const canonicalPath = `/daily/${report.id}/`;
const pageDescription =
  parsed.headlines.length > 0
    ? parsed.headlines.slice(0, 3).join('；')
    : `${report.data.title}，AI 行业资讯日报。`;

// 结构化数据：日报是聚合摘要而非单篇新闻报道，故用 BlogPosting 而非 NewsArticle。
// 新闻卡片在 DOM 中没有稳定 id，不做 ItemList，避免生成虚构的条目 URL。
// sitemap 集成已强制要求 site 配置，缺失时构建即失败，故此处无需回退字面量
const site = Astro.site!;
const modified = report.data.updated ?? report.data.date;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: report.data.title,
  description: pageDescription,
  datePublished: isoDate(report.data.date),
  dateModified: isoDate(modified),
  inLanguage: 'zh-CN',
  mainEntityOfPage: new URL(canonicalPath, site).href,
  image: new URL('/og-image.png', site).href,
  author: { '@type': 'Organization', name: 'AI 日报', url: site.href },
  publisher: { '@type': 'Organization', name: 'AI 日报', url: site.href },
})
  // JSON.stringify 不转义尖括号：标题或速览里若含 </script> 会突破脚本标签
  .replace(/</g, '\\u003c');
---

<Base
  title={`${report.data.title} · AI 日报`}
  description={pageDescription}
  canonicalPath={canonicalPath}
  ogType="article"
>
  <Fragment slot="head">
    {/* application/ld+json 是数据块，浏览器不执行，因此不受 CSP script-src 'self' 限制 */}
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <header class="daily-header">
    <h1>{report.data.title}</h1>
    <div class="daily-meta">
      <time datetime={isoDate(report.data.date)}>
        {formatDate(report.data.date)}
      </time>
      <span><b>{totalNews}</b> 条新闻</span>
      <span><b>{parsed.sections.length}</b> 个板块</span>
      <span><b>{totalSources}</b> 个来源</span>
    </div>
  </header>

  {
    parsed.headlines.length > 0 && (
      <section class="headlines-bar">
        <h2>今日速览</h2>
        <ol>
          {parsed.headlines.map((h) => (
            <li>{h}</li>
          ))}
        </ol>
      </section>
    )
  }

  {
    parsed.sections.map((section) => {
      const meta = getSectionMeta(section.title);
      return (
        <section class={`section-block color-${meta.color}`}>
          <h2 class="section-heading">
            <span class="section-icon">
              <SectionIcon name={meta.icon} size={17} />
            </span>
            <span>{section.title}</span>
            <span class="section-count">{section.items.length} 条</span>
          </h2>
          <div>
            {section.items.map((item) => (
              <article class="news-card">
                <header>
                  <span class="news-id">#{item.id}</span>
                  <h3>{item.title}</h3>
                </header>
                {item.body.length > 0 && (
                  <div class="news-body">
                    {item.body.map((p) => (
                      <p set:html={renderInlineMarkdown(p)} />
                    ))}
                  </div>
                )}
                {item.sources.length > 0 && (
                  <p class="news-source">
                    <span class="source-label">来源：</span>
                    <span
                      class="source-html"
                      set:html={renderSourcesHtml(item.sources)}
                    />
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })
  }

  {
    parsed.disclaimer && (
      <p class="daily-disclaimer">{parsed.disclaimer}</p>
    )
  }

  <nav class="report-nav">
    {
      older ? (
        <a class="prev" href={`/daily/${older.id}/`}>
          <SectionIcon name="arrowLeft" size={16} />
          <span>
            <span class="nav-label">较早一期</span>
            <span class="nav-date">{older.id} · 周{WEEKDAYS[older.data.date.getUTCDay()]}</span>
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer ? (
        <a class="next" href={`/daily/${newer.id}/`}>
          <span>
            <span class="nav-label">较新一期</span>
            <span class="nav-date">{newer.id} · 周{WEEKDAYS[newer.data.date.getUTCDay()]}</span>
          </span>
          <SectionIcon name="arrowRight" size={16} />
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>