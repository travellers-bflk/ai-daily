---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DayCard from '../../../components/DayCard.astro';
import { formatMonthTitle } from '../../../lib/utils';

export async function getStaticPaths() {
  const reports = await getCollection('daily');
  // year-month → reports（key 形如 "2026-09"）
  const tree: Record<string, typeof reports> = {};
  for (const r of reports) {
    const d = r.data.date;
    // 统一 UTC getter（frontmatter 日期为 UTC 午夜）
    const y = d.getUTCFullYear();
    const m = d.getUTCMonth() + 1;
    const key = `${y}-${String(m).padStart(2, '0')}`;
    (tree[key] ??= []).push(r);
  }
  return Object.entries(tree).map(([key, items]) => {
    const [y, m] = key.split('-').map(Number);
    return {
      params: {
        year: String(y),
        month: String(m).padStart(2, '0'),
      },
      props: {
        year: y,
        month: m,
        items: items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
        // 全量月份表，供上/下一月导航做存在性判断
        monthKeys: Object.keys(tree),
      },
    };
  });
}

const { year, month, items, monthKeys } = Astro.props;

// month 为 1-based，Date 构造器月份为 0-based：上一个月 = month-2，下一个月 = month。
// 一律 UTC 构造 + UTC getter，与全站日期基准一致（key 与渲染 label 同基准，避免
// 负偏移构建环境下 label 与链接 key 错位）
const prev = new Date(Date.UTC(year, month - 2, 1));
const next = new Date(Date.UTC(year, month, 1));
const monthKey = (d: Date) =>
  `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
const prevExists = monthKeys.includes(monthKey(prev));
const nextExists = monthKeys.includes(monthKey(next));
---

<Base
  title={`${year} 年 ${month} 月 · AI 日报归档`}
  canonicalPath={`/archive/${year}/${String(month).padStart(2, '0')}/`}
>
  <section class="hero">
    <h1>{formatMonthTitle(year, month)}</h1>
    <p>共 {items.length} 期日报</p>
    <div class="hero-stats">
      {
        prevExists ? (
          <a href={`/archive/${prev.getUTCFullYear()}/${String(prev.getUTCMonth() + 1).padStart(2, '0')}/`}>
            ← {prev.getUTCFullYear()} 年 {prev.getUTCMonth() + 1} 月
          </a>
        ) : (
          <span class="nav-disabled">
            ← {prev.getUTCFullYear()} 年 {prev.getUTCMonth() + 1} 月
          </span>
        )
      }
      <a href="/archive/">全部归档</a>
      {
        nextExists ? (
          <a href={`/archive/${next.getUTCFullYear()}/${String(next.getUTCMonth() + 1).padStart(2, '0')}/`}>
            {next.getUTCFullYear()} 年 {next.getUTCMonth() + 1} 月 →
          </a>
        ) : (
          <span class="nav-disabled">
            {next.getUTCFullYear()} 年 {next.getUTCMonth() + 1} 月 →
          </span>
        )
      }
    </div>
  </section>

  <div class="day-grid">
    {
      items.map((report) => (
        <DayCard report={report} />
      ))
    }
  </div>
</Base>

<style>
  .hero-stats a {
    color: var(--fg-secondary);
  }
  .hero-stats a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .hero-stats .nav-disabled {
    /* 不可点由 cursor 与无下划线表达；文字色仍须达 WCAG AA（--fg-mute 仅 1.5:1） */
    color: var(--fg-faint);
    cursor: default;
  }
</style>