---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 站内规范路径（如 /daily/2026-09-05/），用于 canonical 与 og:url；缺省视为首页 */
  canonicalPath?: string;
  /** og:type：首页 website，日报详情 article */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = '每日 AI 行业资讯日报，由 AI 搜集整理发布。',
  canonicalPath = '/',
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://439952066.xyz');
const canonicalUrl = new URL(canonicalPath, site);
const ogImageUrl = new URL('/og-image.png', site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AI 日报 RSS" href="/rss.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AI 日报" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="site-title" href="/">
          <span class="logo">AI</span>
          <span class="title-zh">AI 日报</span>
          <span class="title-en">AI Daily</span>
        </a>
        <nav class="site-nav">
          <a href="/archive/">归档</a>
          <a href="/rss.xml" target="_blank" rel="noopener">RSS</a>
        </nav>
      </div>
    </header>
    <main class="wrap main-area">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>内容由 AI 辅助搜集整理，可能存在遗漏或错误，请以各来源原文为准。</p>
        <p class="footer-privacy">
          本站点为纯静态内容，无用户追踪、无 Cookie、无遥测上报。
          <a href="/privacy/">隐私说明</a>
        </p>
      </div>
    </footer>
  </body>
</html>